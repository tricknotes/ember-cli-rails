<% app = EmberCli["my-app"] %>
<% app.build %>
<% embedding = EmberCli::Embedding.new(app) %>
<% if embedding.startup_tags? %>
  <%= safe_join(embedding.startup_tags.map(&:html_safe), "\n") %>
<% else %>
  <% embedding.javascript_assets.each do |src| %>
    <script src="<%= src %>"></script>
  <% end %>
  <% embedding.stylesheet_assets.each do |href| %>
    <link rel="stylesheet" href="<%= href %>">
  <% end %>
<% end %>
